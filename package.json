{
  "name": "epytor-vscode",
  "displayName": "EPYTOR",
  "description": "WYSIWYG Markdown editor",
  "version": "1.2.0",
  "publisher": "peiyucn",
  "engines": {
    "vscode": "^1.93.0"
  },
  "packageManager": "pnpm@10.6.1",
  "extensionKind": [
    "ui"
  ],
  "icon": "images/icon.png",
  "categories": [
    "Formatters",
    "Other"
  ],
  "keywords": [
    "markdown",
    "wysiwyg",
    "editor",
    "table",
    "milkdown"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/peiyucn/epytor.git"
  },
  "bugs": {
    "url": "https://github.com/peiyucn/epytor/issues"
  },
  "homepage": "https://github.com/peiyucn/epytor#readme",
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "customEditors": [
      {
        "viewType": "epytor.editor",
        "displayName": "%customEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "epytor.switchToTextEditor",
        "title": "%command.switchToTextEditor.title%",
        "icon": "$(eye-closed)"
      },
      {
        "command": "epytor.switchToPreview",
        "title": "%command.switchToPreview.title%",
        "icon": "$(eye)"
      }
    ],
    "keybindings": [
      {
        "command": "epytor.switchToTextEditor",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "activeCustomEditorId == 'epytor.editor'"
      },
      {
        "command": "epytor.switchToPreview",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "(resourceExtname == '.md' || resourceExtname == '.markdown') && activeCustomEditorId != 'epytor.editor'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "epytor.switchToTextEditor",
          "group": "navigation",
          "when": "activeCustomEditorId == 'epytor.editor'"
        },
        {
          "command": "epytor.switchToPreview",
          "group": "navigation",
          "when": "(resourceExtname == '.md' || resourceExtname == '.markdown') && activeCustomEditorId != 'epytor.editor'"
        }
      ]
    },
    "configuration": {
      "title": "epytor",
      "properties": {
        "epytor.codeBlockMaxHeight": {
          "type": "number",
          "default": 600,
          "minimum": 100,
          "description": "%config.codeBlockMaxHeight.description%"
        },
        "epytor.editorMaxWidth": {
          "type": "number",
          "default": 900,
          "minimum": 400,
          "description": "%config.editorMaxWidth.description%"
        },
        "epytor.serializationMode": {
          "type": "string",
          "enum": [
            "clean",
            "compatible"
          ],
          "enumDescriptions": [
            "%config.serializationMode.clean%",
            "%config.serializationMode.compatible%"
          ],
          "default": "clean",
          "description": "%config.serializationMode.description%"
        },
        "epytor.tableWrapMode": {
          "type": "string",
          "enum": [
            "wrap",
            "nowrap"
          ],
          "enumDescriptions": [
            "%config.tableWrapMode.wrap%",
            "%config.tableWrapMode.nowrap%"
          ],
          "default": "wrap",
          "description": "%config.tableWrapMode.description%"
        },
        "epytor.imageStorage": {
          "order": 10,
          "type": "string",
          "enum": [
            "local",
            "server"
          ],
          "enumDescriptions": [
            "%config.imageStorage.local%",
            "%config.imageStorage.server%"
          ],
          "default": "local",
          "description": "%config.imageStorage.description%"
        },
        "epytor.imageLocalPath": {
          "order": 11,
          "type": "string",
          "default": "",
          "description": "%config.imageLocalPath.description%"
        },
        "epytor.imageServerUrl": {
          "order": 12,
          "type": "string",
          "default": "",
          "description": "%config.imageServerUrl.description%"
        },
        "epytor.imageServerFieldName": {
          "order": 13,
          "type": "string",
          "default": "file",
          "description": "%config.imageServerFieldName.description%"
        },
        "epytor.imageServerExtraParams": {
          "order": 14,
          "type": "string",
          "default": "",
          "description": "%config.imageServerExtraParams.description%"
        },
        "epytor.imageServerResponsePath": {
          "order": 15,
          "type": "string",
          "default": "url",
          "description": "%config.imageServerResponsePath.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.mjs --production",
    "build": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "verify": "pnpm run typecheck && pnpm test && pnpm run vscode:prepublish",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package --no-dependencies --out releases/ --baseContentUrl https://github.com/peiyucn/epytor/blob/main --baseImagesUrl https://github.com/peiyucn/epytor/raw/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.80.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "jsdom": "30.0.1",
    "typescript": "^5.7.0",
    "vite": "^6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.1",
    "@milkdown/crepe": "7.22.1",
    "@milkdown/kit": "7.22.1",
    "katex": "^0.18.0",
    "mermaid": "^11.16.1",
    "prosemirror-commands": "^1.7.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vue": "^3.5.20"
  },
  "overrides": {
    "prosemirror-changeset": "^2.3.1",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.3",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.2"
  }
}
